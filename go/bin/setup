#!/bin/sh
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$PROJECT_DIR"
mkdir -p dist
export GOPATH="$PROJECT_DIR/.cache/gopath"
export GOMODCACHE="$PROJECT_DIR/.cache/gomod"
export GOCACHE="$PROJECT_DIR/.cache/build"
go mod download
CGO_ENABLED=0 go build -trimpath -o dist/monitor ./cmd/monitor
CGO_ENABLED=0 go build -trimpath -o dist/trpc-monitor ./cmd/trpc-monitor
printf '%s\n' 'Built Go and tRPC-Go. Configure .env, then check-config --probe.'
